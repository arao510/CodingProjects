# API keys — never commit these
.env

# Generated indexes — too large, regenerated by ingest.py
.chroma_db/
.bm25_index.pkl

# Cached corpus documents — regenerated on ingest
corpus/

# Custom dataset definitions saved at runtime
.custom_datasets.json

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Mac
.DS_Store

# Eval results — optional, you may want to keep these
evaluation/results/
